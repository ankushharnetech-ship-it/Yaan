{
  "expo": {
    "name": "YAAN Driver",
    "slug": "yaan-driver",
    "scheme": "yaandriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.yaanbooking.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "YAAN Driver shares your live position with your vendor and the trip's operator while a trip is in progress."
      }
    },
    "android": {
      "package": "in.yaanbooking.driver",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "YAAN Driver shares your live position with your vendor and the trip's operator while a trip is in progress."
        }
      ]
    ]
  }
}
