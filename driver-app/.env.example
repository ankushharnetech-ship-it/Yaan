# Copy to .env and edit. Expo reads EXPO_PUBLIC_* variables when the app starts (restart `npm start` after changing).
#
# Phone on the same Wi-Fi as your computer (run the backend with --host 0.0.0.0), use your computer's LAN IP:
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api
# Android emulator (default, no need to set):  http://10.0.2.2:8000/api
# iOS simulator (default, no need to set):     http://localhost:8000/api
# Production (must be HTTPS):                  https://api.yaanbooking.in/api
